{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "LLM Chat Gateway",
  "uid": "llm-chat",
  "tags": [
    "llm-chat",
    "llm",
    "kubernetes"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "panels": [
    {
      "type": "row",
      "title": "Traffic",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 100
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(llm_chat_requests_total[1m])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Requests",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(llm_chat_requests_total)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(llm_chat_requests_total{status=\"error\"}[5m]) / rate(llm_chat_requests_total[5m]) or vector(0)",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Requests",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "llm_chat_active_requests",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Queue Depth",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "llm_chat_queue_depth",
          "legendFormat": "queued"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Tokens / sec",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(llm_chat_tokens_total[1m])",
          "legendFormat": "tok/s"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "id": 101
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Latency",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 14,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(llm_chat_request_duration_seconds_sum[2m]) / rate(llm_chat_request_duration_seconds_count[2m])",
          "legendFormat": "average"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(llm_chat_time_to_first_chunk_seconds_sum[2m]) / rate(llm_chat_time_to_first_chunk_seconds_count[2m])",
          "legendFormat": "average time to first chunk"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency Heatmap (avg by model)",
      "gridPos": {
        "x": 14,
        "y": 6,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(llm_chat_request_duration_seconds_sum[2m]) / rate(llm_chat_request_duration_seconds_count[2m])",
          "legendFormat": "avg {{model}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Throughput & Queue",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "id": 102
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Requests / sec by Status",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(llm_chat_requests_total[1m])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Backend token and stream chunk activity",
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(llm_chat_tokens_total[1m])",
          "legendFormat": "backend-reported tokens \u2014 {{model}}"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "llm_chat_stream_chunks_per_second",
          "legendFormat": "stream chunks/s \u2014 {{model}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Queue Depth over Time",
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": {
            "fixedColor": "#FF9830",
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "llm_chat_queue_depth",
          "legendFormat": "queue depth"
        }
      ]
    }
  ]
}
